{
    "name": "vitisstudio/restdb",
    "description": "RestDB — an Eloquent database driver for RESTful APIs",
    "license": "MIT",
    "keywords": ["laravel", "eloquent", "rest", "api", "database", "driver"],
    "homepage": "https://github.com/VitisStudio/laravel-restdb-driver",
    "authors": [
        {
            "name": "Dan Poblete",
            "email": "dan@vitis.studio"
        }
    ],
    "support": {
        "issues": "https://github.com/VitisStudio/laravel-restdb-driver/issues",
        "source": "https://github.com/VitisStudio/laravel-restdb-driver"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "vitisstudio/restdb-contracts": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Vitis\\RestDB\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vitis\\RestDB\\RestDBServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
